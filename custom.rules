# Brute force

alert http any any -> any any (msg:"Brute force: repeated 401 responses"; flow:to_server,established; http.method; content:"POST"; http.stat_code; content:"401"; detection_filter: track by_src, count 10, seconds 60; sid:2000230;)

alert http any any -> any any (msg:"Brute force: repeated 403 responses"; flow:from_server,established; http.stat_code; content:"403"; detection_filter: track by_src, count 20, seconds 60; sid:1004002;)

alert http any any -> any any (msg:"Brute force: repeated 429 responses"; flow:from_server,established; http.stat_code; content:"429"; detection_filter: track by_src, count 20, seconds 60; sid:1004003;)

alert http any any -> any any (msg:"Brute force: common username with failed login"; flow:to_server,established; http.request_body; pcre:"/(?:^|&)username=(?:root|admin|user|test|guest)(?:&|$)/i"; http.stat_code; content:"401"; detection_filter: track by_src, count 5, seconds 60; sid:1004001;)

alert http any any -> any any (msg:"Brute force: common password with failed login"; flow:to_server,established; http.request_body; pcre:"/(?:^|&)password=(?:123456|admin|12345678|123456789|12345|password|Aa123456|1234567890|Pass@123|admin123|1234567|123123|111111|P@ssw0rd|Admin@123|112233|admintelecom|Aa@123456)(?:&|$)/i"; http.stat_code; content:"401"; detection_filter: track by_src, count 5, seconds 60; sid:1002001;)

