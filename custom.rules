# SQL Injections

alert http any any -> any any (msg:"SQLi: UNION SELECT in body"; flow:to_server,established; http.request_body; content:"UNION"; nocase; fast_pattern; pcre:"/UNION\s+(?:ALL\s+)?SELECT/i"; sid:1000000;)

alert http any any -> any any (msg:"SQLi: UNION SELECT in URI"; flow:to_server,established; http.uri; content:"UNION"; nocase; fast_pattern; pcre:"/UNION\s+(?:ALL\s+)?SELECT/i"; sid:1000010;)

alert http any any -> any any (msg:"SQLi: UNION SELECT in header"; flow:to_server,established; http.header; content:"UNION"; nocase; fast_pattern; pcre:"/UNION\s+(?:ALL\s+)?SELECT/i"; sid:1000012;)

alert http any any -> any any (msg:"SQLi: OR/AND tautology in body"; flow:to_server,established; http.request_body; pcre:"/(?:\bOR\b|\bAND\b)\s+(?:'?[^']*'?\s*=\s*'?[^']*'?|\d+\s*=\s*\d+)/i"; sid:1000001;)

alert http any any -> any any (msg:"SQLi: OR/AND tautology in URI"; flow:to_server,established; http.uri; pcre:"/(?:\bOR\b|\bAND\b)\s+\d+\s*=\s*\d+/i"; sid:1000011;)

alert http any any -> any any (msg:"SQLi: OR/AND tautology in header"; flow:to_server,established; http.header; pcre:"/(?:\bOR\b|\bAND\b)\s+(?:'?[^']*'?\s*=\s*'?[^']*'?|\d+\s*=\s*\d+)/i"; sid:1000013;)

alert http any any -> any any (msg:"SQLi: stacked query in body"; flow:to_server,established; http.request_body; pcre:"/;\s*(?:SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|EXEC)\b/i"; sid:1000002;)

alert http any any -> any any (msg:"SQLi: stacked query in URI"; flow:to_server,established; http.uri; pcre:"/;\s*(?:SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|EXEC)\b/i"; sid:1000014;)

alert http any any -> any any (msg:"SQLi: stacked query in header"; flow:to_server,established; http.header; pcre:"/;\s*(?:SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|EXEC)\b/i"; sid:1000015;)

alert http any any -> any any (msg:"SQLi: comment + keyword in body"; flow:to_server,established; http.request_body; pcre:"/(?:--|#|\/\*)[^\n]{0,20}\b(?:SELECT|UNION|INSERT|UPDATE|DELETE|DROP|OR|AND)\b/i"; sid:1000003;)

alert http any any -> any any (msg:"SQLi: comment + keyword in URI"; flow:to_server,established; http.uri; pcre:"/(?:--|#|\/\*)[^\n]{0,20}\b(?:SELECT|UNION|INSERT|UPDATE|DELETE|DROP|OR|AND)\b/i"; sid:1000016;)

alert http any any -> any any (msg:"SQLi: comment + keyword in header"; flow:to_server,established; http.header; pcre:"/(?:--|#|\/\*)[^\n]{0,20}\b(?:SELECT|UNION|INSERT|UPDATE|DELETE|DROP|OR|AND)\b/i"; sid:1000017;)

alert http any any -> any any (msg:"SQLi: time-based in body"; flow:to_server,established; http.request_body; pcre:"/\b(?:SLEEP|BENCHMARK|WAITFOR\s+DELAY|PG_SLEEP)\s*\(/i"; sid:1000004;)

alert http any any -> any any (msg:"SQLi: time-based in URI"; flow:to_server,established; http.uri; pcre:"/\b(?:SLEEP|BENCHMARK|WAITFOR\s+DELAY|PG_SLEEP)\s*\(/i"; sid:1000018;)

alert http any any -> any any (msg:"SQLi: time-based in header"; flow:to_server,established; http.header; pcre:"/\b(?:SLEEP|BENCHMARK|WAITFOR\s+DELAY|PG_SLEEP)\s*\(/i"; sid:1000019;)

alert http any any -> any any (msg:"SQLi: file read/write in body"; flow:to_server,established; http.request_body; pcre:"/\b(?:LOAD_FILE\s*\(|INTO\s+(?:OUT|DUMP)FILE\b)/i"; sid:1000005;)

