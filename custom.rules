# Web shell

alert http any any -> any any (msg:"Web shell: PHP file requested from uploads folder"; flow:to_server,established; http.uri; content:"/uploads/"; nocase; fast_pattern; content:".php"; nocase; within:100; xbits:set,webshell_run,track ip_dst,expire 60; sid:1000401;)

alert http any any -> any any (msg:"Web shell: PHP filename in file upload"; flow:to_server,established; http.request_body; content:"filename=|22|"; nocase; fast_pattern; content:".php"; nocase; within:50; sid:1000402;)

alert http any any -> any any (msg:"Web shell: PHP code in file upload"; flow:to_server,established; http.request_body; content:"<?php"; nocase; fast_pattern; content:".php"; nocase; within:200; sid:1000403;)

alert http any any -> any any (msg:"Web shell: shell function in file upload"; flow:to_server,established; http.request_body; content:"shell_exec("; nocase; fast_pattern; sid:1000404;)

alert http any any -> any any (msg:"Web shell: command parameter in URI"; flow:to_server,established; http.uri; content:".php?cmd="; nocase; fast_pattern; sid:1000405;)

alert http any any -> any any (msg:"Web shell: curl requesting PHP in uploads"; flow:to_server,established; http.user_agent; content:"curl/"; startswith; http.uri; content:"/uploads/"; nocase; fast_pattern; content:".php"; nocase; within:100; sid:1000406;)

alert tcp any any -> any any (msg:"Web shell: outbound connection after upload"; flow:to_server,established; flags:S; xbits:isset,webshell_run,track ip_src; detection_filter: track by_src, count 5, seconds 60; sid:1000407;)

